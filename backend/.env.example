# Supabase PostgreSQL connection string.
# Keep the password URL-encoded when it contains special characters.
DATABASE_URL=postgresql://postgres.ntlemtioeoglpuvbwnkc:<PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Keep Redis/Celery on the backend server unless a hosted Redis is configured.
REDIS_URL=redis://127.0.0.1:6379/0

# local keeps the existing Docker/filesystem behavior.
STORAGE_BACKEND=local

# Cloudflare R2 / any S3-compatible object storage.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=minor-collision-detection-system
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_REGION=auto
# S3_PRESIGNED_URL_EXPIRES=3600
