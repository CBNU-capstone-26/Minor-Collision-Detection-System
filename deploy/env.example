# 서버용 설정 — 프로젝트 루트에 .env 로 복사해 값을 채운다:  cp deploy/env.example .env
# 백엔드·워커(systemd)와 deploy/install.sh가 이 파일을 읽는다. docker compose도 DB/Redis 값을 사용한다.
# ⚠️ .env 는 git 에 올리지 않는다(.gitignore). 값에는 따옴표·공백·$ 를 쓰지 않는다.

# 접속 주소(도메인). 도메인 없이 IP 로만 접속하면 비워 둔다
DOMAIN=

# Supabase PostgreSQL 또는 Azure Database for PostgreSQL URL.
# 비밀번호의 특수 문자는 percent-encode 한다. 비우면 로컬 MySQL 설정을 사용한다.
# Azure App Service의 AZURE_POSTGRESQL_CONNECTIONSTRING도 인식한다.
DATABASE_URL=
# REDIS_URL을 지정하면 아래 Redis 개별 항목보다 우선한다.
# Azure Cache for Redis는 rediss://:비밀번호@호스트:6380/0 형식을 사용한다.
# Azure의 AZURE_REDIS_CONNECTIONSTRING도 인식한다.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=
REDIS_DB=0
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=capstone_db

# 로그인 토큰 서명 키 — 아무 긴 문자열. 만들기: openssl rand -hex 32
AUTH_SECRET_KEY=
# 로그인 유지 시간(시간)
AUTH_TOKEN_TTL_HOURS=8
# 영상 보관 기간(일) — 업로드한 지 이만큼 지나면 영상과 분석 클립·기록을 모두 지운다(0 이면 안 지움)
VIDEO_RETENTION_DAYS=90

# ── 필요할 때만 ──────────────────────────────────────────────
# 서비스 가중치를 바꿀 때(프로젝트 루트 기준 경로). 비우면 model/config.py 의 SERVICE_WEIGHTS_PATH
SERVICE_WEIGHTS=
# Cloudflare R2 또는 S3 호환 저장소. 기존 R2 영상이 있다면 s3를 선택하고 값들을 모두 채운다.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# CLOUDFLARE_R2_ACCOUNT_ID / CLOUDFLARE_R2_BUCKET / CLOUDFLARE_R2_ACCESS_KEY_ID /
# CLOUDFLARE_R2_SECRET_ACCESS_KEY aliases are also accepted.
# 로컬 저장소를 쓸 때만: 큰 디스크 경로(절대 또는 프로젝트 루트 기준 상대경로).
STORAGE_DIR=
# 여러 웹 오리진을 허용할 때 쉼표로 구분. 비우면 로컬 개발 주소를 허용한다.
CORS_ORIGINS=
# GPU 종류가 달라도 FP16을 자동 검사하고 안전한 경우에만 사용한다.
INFER_FP16=1
