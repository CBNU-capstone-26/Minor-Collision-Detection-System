# 서버용 설정 — 프로젝트 루트에 .env 로 복사해 값을 채운다:  cp deploy/env.example .env
# docker-compose · 백엔드/워커 서비스(systemd) · deploy/install.sh 가 모두 이 한 파일을 읽는다.
# ⚠️ .env 는 git 에 올리지 않는다(.gitignore). 값에는 따옴표·공백·$ 를 쓰지 않는다.

# 접속 주소(도메인). 도메인 없이 IP 로만 접속하면 비워 둔다
DOMAIN=

# 현재 Database-Service 브랜치는 외부 Supabase PostgreSQL을 사용한다.
# backend/.env와 같은 값으로 채운다.
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0

# 로그인 토큰 서명 키 — 아무 긴 문자열. 만들기: openssl rand -hex 32
AUTH_SECRET_KEY=
# 로그인 유지 시간(시간)
AUTH_TOKEN_TTL_HOURS=8
# 영상 보관 기간(일) — 업로드한 지 이만큼 지나면 영상과 분석 클립·기록을 모두 지운다(0 이면 안 지움)
VIDEO_RETENTION_DAYS=90

# ── 필요할 때만 ──────────────────────────────────────────────
# 서비스 가중치를 바꿀 때(프로젝트 루트 기준 경로). 비우면 model/config.py 의 SERVICE_WEIGHTS_PATH
SERVICE_WEIGHTS=
# R2/S3 객체 저장소(기존 DB 행의 영상 키와 호환). 로컬 저장소를 쓸 때만 STORAGE_BACKEND=local.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# 로컬 저장소를 쓸 때만: 영상 저장 폴더를 큰 디스크로 옮길 때. 비우면 프로젝트의 storage/
STORAGE_DIR=
# GPU 서버에서 FP16 추론(python -m model.fp16_check 로 확인한 뒤에만 1)
INFER_FP16=0
