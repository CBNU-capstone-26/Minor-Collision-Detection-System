# 서버용 설정입니다. 프로젝트 루트에 .env로 복사해 값을 채웁니다: cp deploy/env.example .env
# docker-compose, 백엔드와 워커 서비스(systemd), deploy/install.sh가 모두 이 파일 하나를 읽습니다.
# .env는 git에 올리지 않습니다(.gitignore). 값에는 따옴표, 공백, $를 쓰지 않습니다.

# 접속 주소(도메인)입니다. 도메인 없이 IP로만 접속하면 비워 둡니다.
DOMAIN=

# DB와 Redis 비밀번호입니다. 영문과 숫자로 길게 씁니다. 백엔드 접속 주소는 이 값으로 자동으로 만들어집니다.
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# 로그인 토큰 서명 키입니다. 아무 긴 문자열이면 됩니다(만들기: openssl rand -hex 32).
AUTH_SECRET_KEY=
# 로그인 유지 시간(시간)
AUTH_TOKEN_TTL_HOURS=8
# 영상 보관 기간(일)입니다. 업로드한 지 이만큼 지나면 영상과 분석 클립, 기록을 모두 지웁니다(0이면 지우지 않습니다).
VIDEO_RETENTION_DAYS=90

# ---------- 필요할 때만 ----------
# 서비스 가중치를 바꿀 때 씁니다(프로젝트 루트 기준 경로). 비우면 model/config.py의 SERVICE_WEIGHTS_PATH를 씁니다.
SERVICE_WEIGHTS=
# 모델 입력 크기입니다. 가중치 이름에 _s256처럼 크기 표시가 있으면 같은 값을 넣습니다(없으면 비워 두며 224입니다). 다르면 워커가 멈춥니다.
INPUT_SIZE=
# 헤드 시간 풀링입니다. 비워 두면 가중치 이름의 표시(_top3, _avgtop3, 없으면 avg)를 따릅니다. 값을 넣었는데 이름과 다르면 워커가 멈춥니다.
HEAD_TEMPORAL_POOL=
# 영상 저장 폴더를 큰 디스크로 옮길 때 씁니다. 비우면 프로젝트의 storage/를 씁니다.
STORAGE_DIR=
# GPU FP16 추론입니다(기본 켬). 다른 GPU에서 결과가 다르면 0으로 둡니다.
INFER_FP16=1
# DB를 Supabase 등 외부로 옮길 때 주소 전체를 줍니다(이때 MYSQL_ROOT_PASSWORD는 쓰지 않습니다).
DATABASE_URL=
