# SIOT 분석 워커(Celery)입니다. deploy/install.sh가 __REPO__, __USER__를 바꿔 /etc/systemd/system에 설치합니다.
# 로그: journalctl -u siot-worker -f
[Unit]
Description=SIOT analysis worker (Celery)
After=network-online.target docker.service siot-backend.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__/backend
EnvironmentFile=-__REPO__/.env
Environment=PYTHONUNBUFFERED=1
# 분석은 한 번에 하나씩 합니다(워커 1개 전제, app/worker.py의 재시작 정리 참고).
ExecStart=__REPO__/venv311/bin/celery -A app.worker worker --concurrency=1 --loglevel=info
Restart=always
RestartSec=5
# 갱신이나 재시작 때 진행 중 분석이 끝날 때까지 오래 기다리지 않습니다.
# 끊긴 분석은 다음 시작 때 '실패'로 정리되고 화면에서 다시 실행할 수 있습니다.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
