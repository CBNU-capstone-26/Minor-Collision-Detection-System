# Python 캐시
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# 가상 환경
venv/
.venv/
venv311/

# Node, 화면 빌드 결과
node_modules/
dist/
dist-ssr/

# 로그인 토큰 서명 키(서버마다 따로 만들며 절대 커밋하지 않습니다)
backend/.auth_secret
# 서버 설정(비밀번호 등, deploy/env.example을 복사해 만들며 절대 커밋하지 않습니다)
.env

# 업로드 영상과 만든 미디어
storage/
data/
data/train/*.mp4

# 진단, 디버그 결과(탐지 결과 그림 등)
outputs/

# 로컬 레이블링 도구(개인 작업용이라 커밋하지 않습니다)
labeling/

# 서비스 모델은 model/(x3d)이고, 이전 s3d 백본은 로컬 비교용으로만 둡니다.
s3d model/

# 모델 가중치(큰 바이너리라 git에서 제외)
weights/

# YOLO, torch 체크포인트(큰 파일이며 첫 실행 때 자동으로 내려받습니다)
*.pt

# 로컬 노트북과 문서
*.ipynb
*.md
# 팀원 안내 문서(README)는 저장소에 포함합니다.
!README.md
# 서버 배포 안내
!deploy/DEPLOY.md

# 편집기, OS 파일
.vscode/
.idea/
.DS_Store
._*
*.local
