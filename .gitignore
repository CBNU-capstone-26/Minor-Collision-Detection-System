# Python / Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
venv311/

# Node / frontend build output
node_modules/
dist/
dist-ssr/

# 로그인 토큰 서명 키(서버마다 따로 생성 — 절대 커밋하지 않는다)
backend/.auth_secret

# Runtime uploads and generated media
storage/
data/
data/train/*.mp4

# 진단·디버그 산출물(탐지 결과 이미지 등)
outputs/

# 로컬 라벨링 도구 — 개인 작업용이라 커밋하지 않는다
labeling/

# 서비스 모델은 model/(x3d). 이전 s3d 백본은 로컬 비교용으로만 보관
s3d model/

# Model weights (대용량 바이너리 — git에서 제외)
weights/

# YOLO / torch 체크포인트 (대용량 — 첫 실행 시 자동 다운로드)
*.pt

# Local notebooks and docs
*.ipynb
*.md
# 팀원 온보딩 문서(README)는 저장소에 포함
!README.md

# Local editor and OS files
.vscode/
.idea/
.DS_Store
._*
*.local
